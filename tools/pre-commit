#!/bin/sh
# Refuse a commit that would ship a silently stale app. See tools/check-version.sh.
# Not versioned — git hooks live outside the tree. Reinstall with:
#   cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
exec "$(git rev-parse --show-toplevel)/tools/check-version.sh" --staged
